  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#52525b", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#34d399" }
    },
    {
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": ["constant.language", "constant.character"],
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a78bfa" }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.assignment"],
      "settings": { "foreground": "#d4d4d8" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": { "foreground": "#22d3ee" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#f87171" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#d4d4d8" }
    },
    {
      "scope": ["variable.parameter", "variable.other.readwrite"],
      "settings": { "foreground": "#e4e4e7" }
    },
    {
      "scope": ["variable.language"],
      "settings": { "foreground": "#f472b6", "fontStyle": "italic" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#71717a" }
    },
    {
      "scope": ["entity.name.module", "entity.name.namespace"],
      "settings": { "foreground": "#22d3ee" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#fbbf24", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#34d399" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#fbbf24", "fontStyle": "italic" }
    },
    {
      "scope": ["support.variable.property", "variable.other.property"],
      "settings": { "foreground": "#93c5fd" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#f87171" }
    },
    {
      "scope": ["constant.other.color", "constant.other.rgb-value"],
      "settings": { "foreground": "#34d399" }
    },
    {
      "scope": ["entity.name.section"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": { "foreground": "#d4d4d8" }
    }
  ],
  "semanticTokenColors": {
    "function": "#fbbf24",
    "function.declaration": "#fbbf24",
    "method": "#fbbf24",
    "method.declaration": "#fbbf24",
    "variable": "#d4d4d8",
    "variable.readonly": "#60a5fa",
    "parameter": "#e4e4e7",
    "property": "#93c5fd",
    "property.readonly": "#93c5fd",
    "type": "#22d3ee",
    "class": "#22d3ee",
    "interface": "#22d3ee",
    "enum": "#22d3ee",
    "enumMember": "#fb923c",
    "namespace": "#22d3ee",
    "decorator": { "foreground": "#fbbf24", "italic": true },
    "macro": "#f472b6"
  }
}
